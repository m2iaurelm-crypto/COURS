# URL de connexion utilisée par SQLAlchemy pour accéder à PostgreSQL.
# Adapter l'utilisateur, le mot de passe ou le port si votre installation diffère.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/exo2_jwtapi

# Clé secrète utilisée pour signer les JWT et vérifier qu'ils n'ont pas été modifiés.
JWT_SECRET=cba399c937cfebf58902c006feb7f7094a67c48c39aef66b0ec230729ed8ded1

# Algorithme utilisé pour signer et vérifier les JWT.
JWT_ALGORITHM=HS256

# Durée de validité d'un token, en minutes.
JWT_EXPIRE_MINUTES=5
